{
  "name": "devcolorz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-theme-css.mjs && vue-tsc -b --noEmit && vite build",
    "build:only": "node scripts/gen-theme-css.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "node scripts/bundle.mjs",
    "deploy": "node scripts/deploy.mjs",
    "ship": "npm run build && npm run bundle && npm run deploy"
  },
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "basic-ftp": "^6.2.0",
    "color-name-list": "^14.47.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.10"
  }
}
