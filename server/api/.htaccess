# Route every /api/... request to the front controller.
#
# Two mechanisms, because shared hosts differ in which modules they enable and
# a 404 on the API is a silent, total failure. FallbackResource is cleaner and
# needs only mod_dir; the rewrite is the fallback for hosts that disable it.

<IfModule mod_dir.c>
    FallbackResource /api/index.php
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# There is deliberately no blanket `Require all granted` for .php here.
#
# It used to be present, directly under a comment saying the library and route
# files must never be requested — and it granted them. Apache merges
# <FilesMatch> sections *after* the directory-context directives of a nested
# .htaccess, so this section overrode the `Require all denied` in api/lib/ and
# api/routes/ and made every one of those files directly fetchable. index.php
# needs no grant: nothing denies it at this level.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always unset X-Powered-By
</IfModule>

Options -Indexes
